# Copy this file to .env and fill in your own values. Never commit .env.

# Port the API listens on
PORT=5000

# MongoDB Atlas connection string. Replace <username>, <password> and <cluster>.
# The name after the last "/" (boundarypro) is the database that will be created.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/boundarypro?retryWrites=true&w=majority

# Address of the React app (Vite's default). The API only accepts browser requests from here (CORS).
CLIENT_URL=http://localhost:5173
